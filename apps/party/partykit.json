{
  "$schema": "https://www.partykit.io/schema.json",
  "name": "yparty",
  "main": "party/server.ts",
  "compatibilityDate": "2024-07-08",
  "parties": {
    "rooms": "party/rooms.ts"
  },
  "serve": {
    "path": "out", 
    "singlePageApp": true,
    
    "build": {
      
      "entry": [
        "app/client.tsx",
        "app/worker.ts",
        "app/*.html"
     

      ],
      "loader": {
        ".html": "copy",
        ".css": "css",
        ".ico": "copy"
      },
      "outdir": "out",
      "sourcemap": false,
      "minify": true

    }
  },
  "define": {
  
  }
}