{
  "name": "hocuspocus",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm build:pkgroll",
    "build:tsup": "npx tsup ./index.ts --outDir ./dist --target=esnext --format esm --treeshake --shims --publicDir  ",
    "build:pkgroll": "npx pkgroll  --clear-dist --dist ./dist  --treeshake --shims   --target=node22  ",
    "copy:dist": "cp -r ./dist/ ./public ",
    "copy:public": "cp -r ./public/ ./dist ",
    "dev": "node --import=tsx  --experimental-vm-modules --env-file=.env.local ./src/index.ts",
    "vercel:dev": "npm run build && vercel dev --listen 5005",
    "vercel:deploy": "npm run build &&  vercel deploy",
    "cf:deploy": "yarn run build && cf push ",
    "cf:deploy:test": "yarn run build && cf target -o gengig -s test && cf push -f ./manifest-test.yaml",
    "start": "node ./dist/index.mjs",
    "test": "node --import=tsx  --experimental-vm-modules --env-file=.env ./src/test.ts",
    "cf:mount": "cf bind-service yjs flit -c '{\"readonly\":false, \"mount\":\"/var/yjs\"}'"
  },
  "dependencies": {
    "@hocuspocus/extension-logger": "^2.14.0",
    "@hocuspocus/extension-sqlite": "^2.14.0",
    "@hocuspocus/provider": "^2.14.0",
    "@hocuspocus/server": "^2.15.2",
    "sqlite3": "^5.1.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.8"


  },
    "devDependencies": {

      "pkgroll": "^2.11.2",
      "@types/node": "^22.10.2",
      "tsx": "^4.18.0",
      "typescript": "^5.5.4"

    },

  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": "./dist/index.cjs",
  "exports": {
    "index": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "yarn": "1.22.19",
    "npm": "10.9.2",
    "node": "22.*"
  }
}

 