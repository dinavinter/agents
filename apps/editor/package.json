{
  "name": "@stackblitz/typescript-editor",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.mjs",
  "types": "dist/typescript-editor.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    },
    "./worker": {
      "import": "./dist/worker.mjs",
      "require": "./dist/worker.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/view": "^6",
    "@cxai/ata": "^0.0.0",
    "@hocuspocus/provider": "^2.9.0",
    "@typescript/vfs": "^1.5.0",
    "@valtown/codemirror-ts": "3.0.0-9",
    "codemirror": "^6",
    "comlink": "^4.4.1",
    "y-codemirror.next": "^0.3.2",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.10"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
