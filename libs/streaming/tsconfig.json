{
"extends": "@tsconfig/node22/tsconfig.json", 
  "include": ["src/**/*", "../../apps/function/crux.ts" ],
  "exclude": ["node_modules/**/*", "dist/**/*"],
  
"compilerOptions": {
   "skipLibCheck": true,
  "esModuleInterop": true,
  "isolatedModules": true,
  "module": "NodeNext",
  "moduleDetection": "force",
  "allowJs": true,
  
  "lib": [
    "ESNext.Symbol",
    "DOM",
    "DOM.Iterable",
    "ESNext"
  ],
  "paths": {
    "@/*": [
      "./src/*"
    ]
  }
}
}  
